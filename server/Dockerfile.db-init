FROM python:3.11-slim
 
WORKDIR /app
 
# Install PostgreSQL client
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies
COPY requirements-db.txt .
RUN pip install --no-cache-dir -r requirements-db.txt

# Copy scripts and data
COPY init-db/load_data.py /app/
COPY init-db/02-create-normalized-tables.sql /app/
COPY mental_health_services_nwmphn_dataset.csv /data/
COPY mental_health_embedding.csv /data/

RUN chmod +x /app/load_data.py

# Run schema first, then load data
CMD ["sh", "-c", "psql postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB} -f /app/02-create-normalized-tables.sql && python /app/load_data.py"]
